# Linker script that exports the minimal symbols required for libflutter.so

{
  global:
    JNI_OnLoad;
    _binary_icudtl_dat_start;
    _binary_icudtl_dat_size;
    InternalFlutterGpu*;
    kInternalFlutterGpu*;
    patchwing_init;
    patchwing_free_string;
    patchwing_free_update_result;
    patchwing_check_for_downloadable_update;
    patchwing_update_with_result;
    patchwing_next_boot_patch_number;
    patchwing_current_boot_patch_number;
    patchwing_validate_next_boot_patch;
  local:
    *;
};
